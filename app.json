{
  "expo": {
    "name": "CATEC SuperApp",
    "slug": "campus-ios",
    "scheme": "campushub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#ffffff",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.campushub.ios",
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07090e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Выберите фото для профиля или публикации ЦАТЭК.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      ["expo-audio", { "microphonePermission": "Разрешите запись голосовых сообщений." }],
      ["expo-camera", { "cameraPermission": "Разрешите запись видеосообщений.", "microphonePermission": "Разрешите запись звука для видеосообщений.", "recordAudioAndroid": true }],
      ["expo-sensors", { "motionPermission": "Разрешите управление шариком наклоном телефона." }],
      "expo-video",
      "expo-sharing",
      "expo-asset"
    ]
  }
}
